# Másold .env-be (helyi), élesben a Netlify → Site settings → Environment variables alá.

# Supabase
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # CSAK szerveren (Netlify env), soha nem VITE_ előtaggal
EVENT_SLUG=one-night-irottko

# Barion (tesztben a secure.test.barion.com teszt-shopjának kulcsa)
BARION_ENV=test                     # élesben: prod
BARION_POS_KEY=
BARION_PAYEE=                       # a bolt Barion-tárcájának e-mail címe

# Számlázz.hu (a hotel fiókja → Beállítások → Számla Agent kulcsok)
SZAMLAZZ_AGENT_KEY=
SZAMLAZZ_VAT=27                     # KÖNYVELŐVEL EGYEZTETNI (pl. 27 / AAM / TAM)
SZAMLAZZ_EINVOICE=true              # e-számla; a fiókban engedélyezve kell legyen
SZAMLAZZ_PAYMENT_METHOD=Barion
SZAMLAZZ_PREFIX=                    # opcionális számlaszám-előtag
SZAMLAZZ_EMAIL_REPLYTO=             # opcionális: a számla-e-mail válaszcíme

# Resend (a feladó domainje legyen hitelesítve a Resendben)
RESEND_API_KEY=
EMAIL_FROM=One Night at Írottkő <jegy@DOMAIN.hu>

# URL – a Netlify automatikusan beállítja; helyben: http://localhost:8888

# Apple Wallet (a tanúsítványok: netlify/functions/certs/ – gitignore-olt)
APPLE_PASS_P12_PASSWORD=            # a pass.p12 jelszava
APPLE_PASS_TYPE_ID=pass.hu.koszeg.koszegpass
APPLE_TEAM_ID=97FG847W58

# Google Wallet (kulcs: netlify/functions/certs/google-wallet.json)
GOOGLE_WALLET_CLASS_SUFFIX=one_night_irottko_2027

# Wallet-tanúsítványok titkosító kulcsa (netlify/functions/certs.enc). Új kulcs: node scripts/seal-certs.mjs
CERTS_KEY=

# Szkenner és admin PIN
SCANNER_PIN=
ADMIN_PIN=
